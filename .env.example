# Copy to .env and adjust. All values are optional.

# Enables Claude-powered notes, quizzes, tutor answers and revision plans.
# Without it the app falls back to the built-in offline engine.
ANTHROPIC_API_KEY=

# Claude model used when a key is set
CLASSMIND_MODEL=claude-sonnet-5-5

# Where the SQLite database and recorded audio are stored
CLASSMIND_DATA=./data

# Database. Leave empty for SQLite stored in CLASSMIND_DATA. For PostgreSQL:
#   DATABASE_URL=postgresql://classmind:change-me@localhost:5432/classmind
DATABASE_URL=

# Worker processes for the production server (default: 1 on SQLite, up to 4 on PostgreSQL)
WEB_CONCURRENCY=

# Create demo courses/lectures on first run (0 to disable)
CLASSMIND_SEED=1

PORT=5000
